MONGODB_URI=mongodb+srv://USER:PASS@host/rytham?retryWrites=true&w=majority
PORT=3000
TIMEZONE=Asia/Kolkata
NODE_ENV=development
# Comma-separated browser origins. Required when NODE_ENV=production.
CORS_ORIGINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
JWT_SECRET=
JWT_EXPIRES_IN=7d

# MCP stdio identity (backend JWT, never a Google token)
RYTHAM_JWT=

# MCP HTTP (required when NODE_ENV=production)
MCP_API_KEY=rk_live_xxxxxxxxx
MCP_URL=https://rytham-mcp.onrender.com/mcp

# Optional DeepSeek reasoning for the orchestrator (heuristic fallback if unset)
DEEPSEEK_API_KEY=
