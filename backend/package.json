    "@types/node": "^22.15.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.1",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.20.3",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18.0.0"
